# ---------------------------------------------------------------------------
# Core / infrastructure
# ---------------------------------------------------------------------------
APIFY_TOKEN=
DATABASE_URL=
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000
APP_ENV=development
# Local: all. Production: use api on the FastAPI service and worker on the
# separate `python -m api.worker` service.
ROOMRATE_PROCESS_ROLE=all
ROOMRATE_RATE_SOURCE=normalized
ROOMRATE_DEFAULT_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------------
# Neon Auth (login). When NEON_AUTH_URL is set, browser tokens are verified
# against <NEON_AUTH_URL>/.well-known/jwks.json and the Supabase block below is
# not used. Copy the URL from Neon -> Connect -> Auth. Issuer and audience are
# checked only when set (Better Auth uses its base URL for both).
# ---------------------------------------------------------------------------
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_JWT_ISSUER=
NEON_AUTH_JWT_AUDIENCE=

# ---------------------------------------------------------------------------
# Supabase auth (previous login provider; used only without NEON_AUTH_URL)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Phase F — local access-token verification (no per-request network call).
# Set SUPABASE_JWT_SECRET for HS256 (legacy shared-secret) projects, OR
# SUPABASE_JWKS_URL for RS256/ES256 (asymmetric signing-key) projects. When the
# JWKS URL is blank it defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# Audience defaults to "authenticated" (the value Supabase sets on access
# tokens). Leave all blank for the internal API-key-only local/dev path.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Phase A — scrape-job execution guardrails
# ---------------------------------------------------------------------------
# Hard subprocess timeout (seconds) plus per-account concurrency and daily
# quotas enforced at job-creation time.
SCRAPE_JOB_TIMEOUT_SECONDS=1800
SCRAPE_JOB_MAX_ATTEMPTS=3
SCRAPE_JOB_RETRY_BASE_SECONDS=30
SCRAPE_JOB_RETRY_MAX_SECONDS=900
MAX_CONCURRENT_SCRAPE_JOBS_PER_ACCOUNT=2
MAX_DAILY_SCRAPE_JOBS_PER_ACCOUNT=20
# How long a Booking candidate search (auto-setup, the wizard's «Δείξε άλλα»
# and the change-flow refine) may reuse cached scout results instead of
# re-scraping live (~1-4 min + Apify credits per cold search).
# The cache key is the stay itself — destination, check-in, check-out, adults,
# children, rooms, currency, language — and deliberately NOT the candidate
# limit, so the auto-setup search at signup warms the later wizard searches
# for the same stay. Set 0 to force a live re-scrape every time.
PROPERTY_CANDIDATES_CACHE_HOURS=24

# ---------------------------------------------------------------------------
# Phase C — background scheduler (APScheduler)
# ---------------------------------------------------------------------------
# Master switch, schedule-tick cadence (minutes), queued-job executor batch
# size, and the stale-running sweep threshold (minutes).
ROOMRATE_SCHEDULER_ENABLED=true
ROOMRATE_SCHEDULER_TICK_MINUTES=15
ROOMRATE_EXECUTOR_BATCH_SIZE=3
ROOMRATE_STALE_JOB_MINUTES=5

# ---------------------------------------------------------------------------
# Phase D — price alerts
# ---------------------------------------------------------------------------
# Default alert threshold (percent) applied when an account has no explicit
# rule: a competitor move >= this magnitude raises a notification (any direction).
ROOMRATE_DEFAULT_ALERT_THRESHOLD_PCT=10.0
NOTIFICATION_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Phase E — hybrid price-prediction agent (Anthropic)
# ---------------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY blank to skip the LLM entirely and return the
# deterministic statistical-only recommendation (the endpoint stays usable
# without Anthropic credentials).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_SECONDS=75.0
# Room-matching agent: one call scores up to 150 competitor rooms, so it gets
# its own (longer) timeout; the SDK retries it at most once.
ANTHROPIC_MATCHING_TIMEOUT_SECONDS=120.0
MAX_DAILY_PRICE_RECOMMENDATIONS_PER_ACCOUNT=50
PRICE_RECOMMENDATION_CACHE_MINUTES=15
PRICE_RECOMMENDATION_MAX_CHANGE_PCT=20.0
# Audit rows keep the full request/response payload of every pricing decision.
# A nightly job deletes rows past this age; 0 keeps them forever.
PRICE_RECOMMENDATION_AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Production hardening — startup validation, rate limiting, logging, retention
# ---------------------------------------------------------------------------
# APP_ENV=production (or prod) makes the API refuse to boot when DATABASE_URL
# is empty, INTERNAL_API_KEY is the public dev default "dev-roomrate-key" (or
# shorter than 24 characters), or no Supabase auth source (SUPABASE_JWT_SECRET
# / SUPABASE_JWKS_URL / SUPABASE_URL) is configured. It also enables the
# Strict-Transport-Security response header. Localhost-only CORS_ORIGINS logs
# a warning but does not block boot.
#
# Per-caller cap (the caller's bearer token, an internal caller's account id,
# else the client IP) for the expensive mutation POSTs: scrape-jobs,
# onboarding auto-setup/owned-property, price-recommendation and room-matches.
# Counted per minute in PostgreSQL, so it holds across every worker and API
# replica (a failing database check falls back to per-process counting).
# 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=30
# "text" (human-readable, default) or "json": one JSON object per log line
# with timestamp/level/logger/message, the structured extras the code already
# attaches (job_id, account_id, config_id, notification_count, ...) and the
# per-request X-Request-ID correlation id. Use "json" with log aggregators.
LOG_FORMAT=text
# Daily scheduler job deletes per-job scraper CSVs under output/scrapes/
# older than this many days. Structured results live in PostgreSQL — the CSVs
# are debugging artifacts only. 0 disables the cleanup.
SCRAPE_CSV_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Error monitoring (Sentry) — optional
# ---------------------------------------------------------------------------
# Leave SENTRY_DSN blank to disable monitoring completely: the API then never
# imports sentry_sdk and never opens a transport (the default for local dev,
# CI and the test suite). Set it and the API reports unhandled exceptions
# tagged with APP_ENV, with send_default_pii=False so request bodies, headers,
# cookies and user identifiers are never sent to Sentry.
SENTRY_DSN=
# Performance tracing sample rate, 0.0-1.0. 0 (default) reports errors only;
# 0.05-0.2 is a sane range when you actually need latency traces.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Container runtime (docker-compose.prod.yml) — read by the container, NOT by
# the application code
# ---------------------------------------------------------------------------
# The API and the worker run from ONE image (Dockerfile.api) with two commands;
# ROOMRATE_PROCESS_ROLE is set per service in docker-compose.prod.yml and
# overrides the value above. These three are consumed by the container entry
# command and by Compose interpolation — Settings ignores them.
PORT=8000
UVICORN_WORKERS=4
# Image tag Compose builds/runs; bump it per release so a rollback is one
# `ROOMRATE_IMAGE_TAG=<previous> docker compose -f docker-compose.prod.yml up -d`.
ROOMRATE_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Frontend / Angular browser-safe values
# ---------------------------------------------------------------------------
# The Angular app does NOT read env vars. Browser-safe config is served at
# runtime from frontend/public/runtime-config.js (window.__ROOMRATE_CONFIG__),
# so one built bundle can move between environments; local `ng serve` uses
# frontend/src/environments/environment.development.ts instead.
# Set apiBaseUrl / supabaseUrl / supabaseAnonKey / mapboxToken there.
# Never put INTERNAL_API_KEY, DATABASE_URL or any secret in that file —
# every visitor can read it.
